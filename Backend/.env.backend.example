# Used by base.py to locate this file
ENV_FILE=.env.backend.local

# Required by Django
DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL config for Docker + django-environ
POSTGRES_DB=freemarket
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Required by django-environ's env.db()
DATABASE_URL=postgres://postgres:postgres@db:5432/freemarket
